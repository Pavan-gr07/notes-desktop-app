{
    "name": "electron-ts-app",
    "version": "1.0.0",
    "description": "",
    "main": "dist/main/main.js",
    "scripts": {
        "dev:renderer": "vite",
        "build:main": "tsc -p tsconfig.main.json",
        "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run start\"",
        "start": "npm run build:main && cross-env NODE_ENV=development electron ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@types/node": "^25.0.8",
        "@types/react": "^19.2.8",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "electron": "^39.2.7",
        "install": "^0.13.0",
        "npm": "^11.7.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "wait-on": "^9.0.3"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.18",
        "lucide-react": "^0.562.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "tailwindcss": "^4.1.18"
    },
    "build": {
        "appId": "com.yourname.electronapp",
        "productName": "ElectronNotes",
        "directories": {
            "output": "dist/installers"
        },
        "files": [
            "dist/main/**/*",
            "dist/preload/**/*",
            "dist/renderer/**/*",
            "package.json"
        ],
        "win": {
            "target": "nsis",
            "icon": "public/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}